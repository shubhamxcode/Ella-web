 "duration": 38.862,
 "cues": [
  {
   "id": "hello",
   "start": 1.25,
   "end": 2.21,
   "line": "Hi! I'm Ella!"
  },
  {
   "id": "menubar",
   "start": 2.47,
   "end": 5.593,
   "line": "I live in your Mac's menu bar! Hold control and shift, and just talk to me!"
  },
  {
   "id": "talk",
   "start": 5.853,
   "end": 9.661,
   "line": "Ask me anything! In English, or in Hindi, and I'll answer you out loud!"
  },
  {
   "id": "screen",
   "start": 9.921,
   "end": 14.096,
   "line": "Stuck on something? Hold control and option, I'll see your screen, and explain it, with my pen!"
  },
  {
   "id": "draw",
   "start": 14.356,
   "end": 19.229,
   "line": "Reading a book online? Draw on it, or highlight a line! I'll see it, explain it, and help you read!"
  },
  {
   "id": "mail",
   "start": 19.489,
   "end": 23.111,
   "line": "I read your Gmail, tell you what really needs you, and put your interviews on your calendar!"
  },
  {
   "id": "control",
   "start": 23.371,
   "end": 26.197,
   "line": "I open your apps, run your browser, and I can even type for you!"
  },
  {
   "id": "board",
   "start": 26.457,
   "end": 28.508,
   "line": "Want to see it? I'll sketch it for you, on my whiteboard!"
  },
  {
   "id": "memory",
   "start": 28.768,
   "end": 31.612,
   "line": "I remember what matters to you, and I'll help you hit your goals!"
  },
  {
   "id": "privacy",
   "start": 31.872,
   "end": 34.233,
   "line": "And don't worry! I only listen while you hold the keys."
  },
  {
   "id": "cta",
   "start": 34.693,
   "end": 36.802,
   "line": "I'm Ella! Made for your Mac! Let's talk!"
  }
 ],
